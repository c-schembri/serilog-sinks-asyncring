<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition=" '$(OS)' == 'Windows_NT'">net48</TargetFrameworks>
    <TargetFrameworks>$(TargetFrameworks);net6.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyOriginatorKeyFile>../../assets/Serilog.Sinks.AsyncRing.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition=" '$(OS)' != 'Windows_NT' ">true</PublicSign>
    <!-- TUnit's assertions pick their collection overloads with [OverloadResolutionPriority] (C# 13). -->
    <LangVersion>latest</LangVersion>
    <!-- TUnit test projects are executables. Set here as well as in TUnit's package, so the first restore
         already knows (the .NET Framework build needs a runtime identifier for executables). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The library supports .NET 6, so it's tested there, even though .NET 6 is out of support and some of
       TUnit's dependencies don't officially support it. -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Serilog.Sinks.AsyncRing\Serilog.Sinks.AsyncRing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.69.0" />
    <!-- Test summaries and failure annotations in GitHub Actions. -->
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- The original package, referenced under an alias so its types don't clash with ours; used to check
         that the public API is identical. -->
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" Aliases="upstream" />
  </ItemGroup>

</Project>
