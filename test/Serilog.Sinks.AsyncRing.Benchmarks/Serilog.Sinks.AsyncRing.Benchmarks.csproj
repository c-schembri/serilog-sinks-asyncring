<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Both runtimes, so BenchmarkDotNet can run every benchmark on each. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Serilog.Sinks.AsyncRing\Serilog.Sinks.AsyncRing.csproj" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The original, under an alias so both can be used side by side. -->
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" Aliases="upstream" />
  </ItemGroup>

</Project>
